# Phase one: required public OAuth configuration (not secrets)
# HTTPS origin only, no /mcp path. Also the Auth0 API Identifier / JWT audience.
BRIDGE_PUBLIC_ORIGIN=https://bridge.example.com
# Auth0 tenant origin; use the same issuer/domain as its discovery metadata.
MCP_OAUTH_ISSUER=https://your-tenant.example.auth0.com/
# Exact Auth0 User ID of the one human allowed to use this bridge.
MCP_OAUTH_SUBJECT=
# Exact pre-registered ChatGPT OAuth application's Client ID.
MCP_OAUTH_CLIENT_ID=

# Required for the real Together flow
TOGETHER_ENABLED=true
# Your main NetEase account UID; only this account can invite/chat.
NETEASE_INVITER_UID=
# SENSITIVE: Ash's separate account session, obtained locally. Never paste into chat.
NETEASE_COOKIE=

# Optional server settings
NODE_ENV=production
PORT=8787
TOGETHER_POLL_INTERVAL_MS=4000
TOGETHER_HEARTBEAT_INTERVAL_MS=10000
TOGETHER_PLAYBACK_RECONCILE_INTERVAL_MS=30000
TOGETHER_PLAYBACK_CONTROL_TIMEOUT_MS=8000
TOGETHER_PLAYBACK_DIAGNOSTICS=false
# Optional local socket; protected with the same OAuth, file mode 0600.
BRIDGE_UNIX_SOCKET=
# SENSITIVE / OPTIONAL: absent means POST /events is disabled.
# If enabled, use a separate random secret of at least 32 characters.
BRIDGE_INGEST_TOKEN=
